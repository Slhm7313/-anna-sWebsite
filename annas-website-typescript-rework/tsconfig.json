{
  "compilerOptions": {
    /* --- Environment & Target --- */
    "target": "ES2022",
    /* Target standard JavaScript version */
    "module": "ESNext",
    /* Module code generation format */
    "lib": [
      "ES2022",
      "DOM"
    ],
    /* Included environment type definitions (Node/Browser) */

    /* --- Directories --- */
    "rootDir": "./src",
    /* Where your source TypeScript files live */
    "outDir": "./dist",
    /* Where compiled JavaScript files will go */

    /* --- Strictness & Safety (Crucial) --- */
    "strict": true,
    /* Turns on all strict type-checking options */
    "skipLibCheck": true,
    /* Skips type checking of declaration files (.d.ts) for faster builds */
    "forceConsistentCasingInFileNames": true,
    /* Prevents casing-mismatch bugs across different OSs */

    /* --- Interoperability --- */
    "esModuleInterop": true
    /* Allows default imports from modules that don't export default */
  },
  "include": [
    "src/**/*"
  ],
  /* Tells TypeScript which files to compile */
  "exclude": [
    "node_modules",
    "dist"
  ]
  /* Tells TypeScript which folders to ignore */
}